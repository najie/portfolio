---
import {
  Card,
  CardAction,
  CardHeader,
  CardTitle,
  CardDescription,
  CardContent,
  CardFooter,
} from "@/components/ui/card"
import { Badge } from "@/components/ui/badge"
import {
  FinanceToTheMoonLogo,
  SeLogerLogo,
  VizziaLogo,
} from "@/components/client-logos"

const experiences = [
  {
    company: "Oui",
    role: "Freelance Senior Developer",
    period: "2026 – Present",
    location: "Paris",
    summary:
      "Independent frontend work for product teams, from first screens to production.",
    highlights: [
      "Built the operator web app for Vizzia's video enforcement platform: rule creation, detection review and case processing.",
      "Delivered across the stack's front half: React screens, shared design system components and the BFF connecting them to the rules engine.",
      "Set up an AI-assisted delivery workflow with agent task orchestration and automated code review.",
    ],
    clients: [VizziaLogo, SeLogerLogo, FinanceToTheMoonLogo],
    stack: [
      "React",
      "TypeScript",
      "TanStack",
      "React Aria",
      "Hono",
      "Claude Code",
      "Agentic",
      "Astro",
      "Tailwind CSS",
    ],
  },
  {
    company: "AVIV Group",
    role: "Senior Frontend Developer",
    period: "June 2020 – 2026",
    location: "Paris",
    summary:
      "B2B SaaS products for real-estate professionals across France, Belgium, and Germany at one of Europe's leading real-estate tech companies.",
    highlights: [
      "Architected and delivered three B2B web apps from scratch to production, used by thousands of real-estate agents.",
      "Designed a micro-frontend architecture improving deployment independence and platform scalability.",
      "Set up frontend testing strategy (~80% coverage) and Datadog RUM monitoring across products.",
    ],
    stack: [
      "React",
      "TypeScript",
      "React Query",
      "Zustand",
      "Design System",
      "Vitest",
      "Cypress",
      "MSW",
      "AWS",
      "Terraform",
      "CircleCI",
      "Datadog",
      "LaunchDarkly",
    ],
  },
  {
    company: "Interencheres",
    role: "Lead Frontend Developer",
    period: "Sept. 2016 – June 2020",
    location: "Paris",
    summary:
      "Joined as Frontend Developer and grew into Lead, driving the frontend across the public marketplace and the back-office.",
    highlights: [
      "Led the merger of interencheres.com and interencheres-live.com using Vue.js 2 and Vuex.",
      "Designed and built the back-office app with AngularJS and Angular Material.",
      "Frontend reference for quality, consistency, and UX; helped adopt agile tooling (Asana etc.).",
    ],
    stack: ["JavaScript", "Vue.js 2", "Vuex", "AngularJS", "Angular Material"],
  },
]
---

<section id="experience" class="scroll-mt-8">
  <h2 class="section-label">Experience</h2>
  <div class="flex flex-col gap-4">
    {
      experiences.map((xp) => (
        <Card>
          <CardHeader>
            <CardAction>
              <Badge variant="outline">{xp.period}</Badge>
            </CardAction>
            <CardTitle>{xp.role}</CardTitle>
            <CardDescription>
              <span class="font-medium text-foreground">{xp.company}</span> ·{" "}
              {xp.location} · {xp.summary}
            </CardDescription>
          </CardHeader>
          <CardContent>
            <ul class="space-y-1.5 text-sm">
              {xp.highlights.map((h) => (
                <li class="flex gap-2">
                  <span aria-hidden="true" class="text-muted-foreground">
                    —
                  </span>
                  {h}
                </li>
              ))}
            </ul>
            {xp.clients && (
              <>
                <h3 class="mt-5 mb-2.5 font-display text-[15px] tracking-[0.14em] text-muted-foreground uppercase">
                  Clients &amp; projects
                </h3>
                <ul class="grid grid-cols-3 gap-2">
                  {xp.clients.map((Logo) => (
                    <li class="grid h-16 place-items-center rounded-[14px] bg-white text-foreground shadow-xs">
                      <Logo className="h-7 max-w-[72%]" />
                    </li>
                  ))}
                </ul>
              </>
            )}
          </CardContent>
          <CardFooter className="flex flex-wrap gap-1.5">
            {xp.stack.map((tech) => (
              <Badge variant="outline">{tech}</Badge>
            ))}
          </CardFooter>
        </Card>
      ))
    }
  </div>
</section>
