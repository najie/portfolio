---
interface Props {
  quiet?: boolean
}
const { quiet = false } = Astro.props
---

<div aria-hidden="true" class:list={["wallpaper", { quiet }]}>
  <span
    class="pool bg-[#ff92c8] opacity-45"
    style="width:520px;height:520px;left:50%;top:-140px;margin-left:-364px"
  ></span>
  <span
    class="pool bg-[#2bbdf5] opacity-30"
    style="width:420px;height:420px;left:50%;top:40px;margin-left:42px"></span>
  <span
    class="pool bg-[#c9b8ff] opacity-35"
    style="width:600px;height:600px;left:50%;top:60vh;margin-left:-300px"
  ></span>
</div>

<script>
  import {
    SURGE_MS,
    SURGE_RISE_MS,
    SURGE_SETTLE_MS,
    cycleTime,
    msToNextCycle,
  } from "@/lib/motion-clock"

  // The drift itself is CSS; this shapes its speed and blur on the shared motion clock. Each cycle opens with
  // a surge: the pools rush in every direction while turning sharp, then slow and soften into the slow pace.
  const PEAK_RATE = 7
  const SHARP_BLUR = 12
  const SOFT_BLUR = 90

  const wallpaper = document.querySelector<HTMLElement>(".wallpaper")
  const drifts = wallpaper?.getAnimations({ subtree: true }) ?? []

  function tick(now: number) {
    const t = cycleTime(now)
    const surging = t < SURGE_MS
    const surge = !surging
      ? 0
      : t < SURGE_RISE_MS
        ? (t / SURGE_RISE_MS) ** 2
        : (1 - (t - SURGE_RISE_MS) / SURGE_SETTLE_MS) ** 2
    // the page opens sharp, so the very first rise holds it there instead of sharpening from soft
    const opening = now < SURGE_RISE_MS
    const sharpness = opening ? 1 : surge
    for (const drift of drifts) drift.playbackRate = 1 + (PEAK_RATE - 1) * surge
    wallpaper?.style.setProperty(
      "--pool-blur",
      `${SOFT_BLUR - (SOFT_BLUR - SHARP_BLUR) * sharpness}px`
    )
    if (surging) requestAnimationFrame(tick)
    // slow pace until the next cycle, without a frame loop
    else setTimeout(() => requestAnimationFrame(tick), msToNextCycle(now))
  }

  // Empty under prefers-reduced-motion, where the CSS drift is off and the pools keep their full blur.
  if (drifts.length) requestAnimationFrame(tick)
</script>
