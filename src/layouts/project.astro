---
import "@/styles/global.css"
import ProjectLayoutHeader from "@/components/project-layout-header.astro"
import Wallpaper from "@/components/wallpaper.astro"

interface Props {
  title: string
}

const { title } = Astro.props
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Oui</title>
  </head>
  <body>
    <Wallpaper quiet />
    <ProjectLayoutHeader />
    <main class="h-dvh w-screen overflow-hidden">
      <slot />
    </main>
  </body>
</html>
